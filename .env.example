# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cerebras — HTML codegen
CEREBRAS_API_KEY=

# Gemini Live on Vertex AI — native speech-to-speech voice (billed to Google Cloud)
# API key restricted to the Vertex AI API
VERTEX_API_KEY=
VERTEX_PROJECT=
# Optional overrides, default us-central1 and gemini-3.8-live
VERTEX_LOCATION=
GEMINI_LIVE_MODEL=

# Azure OpenAI — Realtime (kept for a future GPT voice option; unused today)
# e.g. https://your-resource.openai.azure.com
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# Deployment name in Foundry, e.g. gpt-realtime-2-1-mini
AZURE_OPENAI_REALTIME_DEPLOYMENT=

# Azure Foundry — Fireworks gpt-oss for in-app buddy
# e.g. https://your-project.services.ai.azure.com/models
AZURE_FIREWORKS_ENDPOINT=
AZURE_FIREWORKS_API_KEY=
# Model id from Foundry catalog, e.g. fireworks-ai/gpt-oss-120b
AZURE_FIREWORKS_MODEL=
